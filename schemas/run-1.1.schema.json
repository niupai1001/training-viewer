{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:training-viewer:run:1.1",
  "title": "Training Viewer Run Metadata v1.1",
  "type": "object",
  "properties": {
    "schema_version": { "const": "1.1" },
    "run_id": { "type": "string", "minLength": 1 },
    "project": { "type": "string", "minLength": 1 },
    "experiment": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "task": { "type": "string" },
    "experiment_description": {
      "type": "object",
      "properties": {
        "data_description": { "type": "string", "minLength": 1 },
        "model_architecture": { "type": "string", "minLength": 1 },
        "modification_plan": { "type": "string", "minLength": 1 },
        "research_objective": { "type": "string", "minLength": 1 },
        "change_details": { "type": "string" }
      },
      "required": [
        "data_description",
        "model_architecture",
        "modification_plan",
        "research_objective"
      ],
      "additionalProperties": false
    },
    "model": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "architecture": { "type": "string" },
        "version": { "type": "string" }
      },
      "required": ["name"],
      "additionalProperties": true
    },
    "dataset": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string" },
        "fingerprint": { "type": "string" },
        "split_definition": { "type": "string" }
      },
      "required": ["name"],
      "additionalProperties": true
    },
    "config": { "type": "object", "additionalProperties": true },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "source": {
      "type": "object",
      "properties": {
        "git_commit": { "type": "string" },
        "git_dirty": { "type": "boolean" },
        "seed": { "type": "integer" },
        "framework": { "type": "string" },
        "code_ref": { "type": "string" }
      },
      "additionalProperties": true
    },
    "metric_definitions": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "display_name": { "type": "string" },
          "display_name_en": { "type": "string" },
          "direction": { "enum": ["min", "max", "none"] },
          "unit": { "type": "string" },
          "description": { "type": "string" },
          "definition": { "type": "string" },
          "comparison_key": { "type": "string" },
          "aggregation": { "type": "string" },
          "category": {
            "enum": ["loss", "validation_score", "learning_rate", "performance", "system", "custom"]
          },
          "semantic_group": {
            "enum": ["training_trend", "performance", "evaluation", "other"]
          },
          "suggested_view": {
            "enum": ["line", "evaluation_table", "scatter", "heatmap", "raw"]
          },
          "default_visibility": { "type": "boolean" },
          "is_primary": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "metric_groups": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "label": { "type": "string" },
          "prefix": { "type": "string" },
          "dimensions": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": true
      }
    },
    "extensions": { "type": "object" }
  },
  "required": ["schema_version", "run_id", "project", "name", "created_at", "experiment_description"],
  "additionalProperties": false
}
