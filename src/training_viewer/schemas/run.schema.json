{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:training-viewer:run:1.0",
  "title": "Training Viewer Run Metadata v1.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "experiment": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "task": {
      "type": "string"
    },
    "model": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "architecture": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": true
    },
    "dataset": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string"
        },
        "fingerprint": {
          "type": "string"
        },
        "split_definition": {
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": true
    },
    "config": {
      "type": "object",
      "additionalProperties": true
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "source": {
      "type": "object",
      "properties": {
        "git_commit": {
          "type": "string"
        },
        "git_dirty": {
          "type": "boolean"
        },
        "seed": {
          "type": "integer"
        },
        "framework": {
          "type": "string"
        },
        "code_ref": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "metric_definitions": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "display_name": {
            "type": "string"
          },
          "direction": {
            "enum": [
              "min",
              "max",
              "none"
            ]
          },
          "unit": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "comparison_key": {
            "type": "string"
          },
          "aggregation": {
            "type": "string"
          },
          "definition": {
            "type": "string"
          }
        },
        "required": [
          "direction"
        ],
        "additionalProperties": false
      }
    },
    "extensions": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "project",
    "name",
    "created_at"
  ],
  "additionalProperties": false
}
