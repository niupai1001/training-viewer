{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "created_at",
    "experiment",
    "variant",
    "metrics",
    "view"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "experiment": {
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "variant": {
      "type": "object",
      "required": [
        "id",
        "name",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "baseline",
            "ablation",
            "modification"
          ]
        },
        "description": {
          "type": "string"
        },
        "baseline_id": {
          "type": "string"
        }
      }
    },
    "config": {
      "type": "object"
    },
    "metrics": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "label",
          "unit",
          "direction",
          "role"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": "string"
          },
          "direction": {
            "enum": [
              "min",
              "max",
              "none"
            ]
          },
          "role": {
            "enum": [
              "loss",
              "score",
              "other"
            ]
          }
        }
      }
    },
    "view": {
      "type": "object",
      "required": [
        "charts",
        "numbers",
        "primary_metric"
      ],
      "properties": {
        "charts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "numbers": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "primary_metric": {
          "type": "string"
        }
      }
    }
  }
}